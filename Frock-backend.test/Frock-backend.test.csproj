<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Frock_backend.test</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="transport company\**" />
    <EmbeddedResource Remove="transport company\**" />
    <None Remove="transport company\**" />
    <SpecFlowFeatureFiles Remove="transport company\**" />
    <SpecFlowObsoleteCodeBehindFiles Remove="transport company\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	<PackageReference Include="Moq" Version="4.20.72" />
	<PackageReference Include="SpecFlow" Version="3.9.74" />
	<PackageReference Include="SpecFlow.Tools.MsBuild.Generation" Version="3.9.74" />
	<PackageReference Include="SpecFlow.xUnit" Version="3.9.74" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frock-backend\Frock-backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="stops\DeleteStop.feature.cs">
      <DependentUpon>DeleteStop.feature</DependentUpon>
    </Compile>
    <Compile Update="stops\GetAllStopsByFkIdCompany.feature.cs">
      <DependentUpon>GetAllStopsByFkIdCompany.feature</DependentUpon>
    </Compile>
    <Compile Update="companies\CreateCompanie.feature.cs">
      <DependentUpon>CreateCompanie.feature</DependentUpon>
    </Compile>
    <Compile Update="companies\UpdateCompanie.feature.cs">
      <DependentUpon>UpdateCompanie.feature</DependentUpon>
    </Compile>
    <Compile Update="auth\SignIn.feature.cs">
      <DependentUpon>SignIn.feature</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
